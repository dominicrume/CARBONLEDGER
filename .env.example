# CarbonLedger environment. Copy to .env and fill in. Never commit .env. Never paste these values into a chat or a model.
# One config source per runtime (ENGINEERING rule 14): the server reads this file, the web app reads apps/web/js/config.js.
# There is no .env.local: the web app is static and has no build step. CI reads GitHub Actions secrets, not this file.
# A key with KEY, SECRET, TOKEN or PASSWORD in its name must stay a <placeholder> here (tests/test_repo_contracts.py).

# ---------- Stage 0: demo on this machine (nothing to obtain) ----------
APP_ENV=dev                                   # dev shows /docs. Anything else hides it.
CHAIN_MODE=dry-run                            # dry-run | solana-devnet. Mainnet is a human gate, not a value.
WEB_ORIGIN=http://127.0.0.1:8080              # The one origin CORS allows. Must match where the app is served.
API_PORT=8000
LOG_LEVEL=info                                # Logs hold ids and hashes only (ENGINEERING rule 13).
MAX_REQUEST_BYTES=65536                       # Request size limit in front of the API.
REQUEST_TIMEOUT_SECONDS=40                    # Must exceed two RPC calls at SOLANA_RPC_TIMEOUT_SECONDS each.

# ---------- Stage 0b: first real devnet transaction (D14) ----------
# Make the hot key on your own machine, never in a chat:
#   solana-keygen new --outfile ~/.config/solana/carbonledger-devnet.json
#   solana config set --url devnet
#   solana airdrop 2 ~/.config/solana/carbonledger-devnet.json
# Base58 secret for the variable below (prints once, copy into .env only):
#   python3 -c "import json,base58;print(base58.b58encode(bytes(json.load(open('$HOME/.config/solana/carbonledger-devnet.json')))).decode())"
# This is a hot key with a tiny balance. It signs memos only. It is never the registry authority or a verifier.
SOLANA_RPC_URL=https://api.devnet.solana.com  # Public endpoint. Rate limited. Fine for the demo.
SOLANA_RPC_URL_FALLBACK=                      # Optional second provider (Helius, QuickNode or Triton free tier), devnet URL.
SOLANA_RPC_TIMEOUT_SECONDS=15
SOLANA_COMMITMENT=confirmed                   # The API says "recorded" only at this level or better (D5).
SOLANA_SECRET_KEY_B58=<set in your secret store, never here>
SOLANA_EXPLORER=https://explorer.solana.com/tx/{sig}?cluster=devnet
ANCHOR_INTERVAL_SECONDS=2                     # The anchor worker waits this long after a receipt to gather more into one Merkle root (D15).

# ---------- Stage 1: login, limits, identity (D2, KYA) ----------
# Generate on your machine:  openssl rand -hex 32
# Mixed into every stored key hash. Rotating it invalidates every key.
API_KEY_PEPPER=<openssl rand -hex 32>
# Keys made by scripts/make_api_key.py when no database is configured: role:owner:hash, comma separated.
# With DATABASE_URL set, the script stores the hash in the api_keys table instead and this stays empty.
API_KEYS=<empty, or role:owner:hash entries from scripts/make_api_key.py>
# dev or test only: one plaintext key for local tools and the browser test. Never set outside dev and test.
API_DEMO_KEY=<dev only, any clk_personal_... string>
API_DEMO_BUSINESS_KEY=<dev only, any clk_business_... string, for the mandate screen>
# Self-serve demo logins on a public demo of simulated units: only with APP_ENV=demo. A few per hour per address.
DEMO_LOGINS=0
DEMO_LOGINS_PER_HOUR=10
RATE_LIMIT_PER_MINUTE=60                      # Per API key, token bucket.
RATE_LIMIT_BURST=20
AGENT_SIGNATURE_MAX_AGE_SECONDS=120           # An agent request older than this is refused as a replay.
# Registry roles. Public keys only. The private keys live in a hardware wallet or a Squads multisig, never on a laptop.
# The trustee. Issues batches, links credits, suspends.
REGISTRY_AUTHORITY_PUBKEY=<public key of the multisig or hardware wallet>
# Comma separated, up to three. A named person or institution each.
VERIFIER_PUBKEYS=<public key, public key>
ATTEST_TWO_ABOVE_G=100000000                  # Attestations above this (100 t) need two verifier signatures.

# ---------- Stage 1b: Postgres (D4, D9) ----------
# Local:  docker compose up -d db   (docker-compose.yml reads POSTGRES_PASSWORD from this file)
# Hosted later: Supabase, Neon or RDS. Point-in-time restore on. The app role never gets UPDATE or DELETE on history.
POSTGRES_PASSWORD=<openssl rand -hex 24>
DATABASE_URL=postgresql://carbonledger_app:<same password>@127.0.0.1:5432/carbonledger
DATABASE_URL_MIGRATOR=postgresql://postgres:<same password>@127.0.0.1:5432/carbonledger   # Migrations only. Not the app role.
DATABASE_POOL_SIZE=10
# A scratch database for tests/test_db_*.py. Its name must end with _test: the tests reset it. Unset = those tests skip.
DATABASE_URL_TEST=postgresql://postgres:<same password>@127.0.0.1:5433/carbonledger_test
POSTGRES_PORT=5433                            # docker-compose.yml publishes Postgres here on 127.0.0.1 (5432 is often taken).

# ---------- Stage 1c: the Anchor program (D3) ----------
# After `anchor build` and `anchor keys list`. Until then the API uses the memo path.
CARBON_REGISTRY_PROGRAM_ID=                   # Paste from `anchor keys list`. Also goes in Anchor.toml and apps/web/js/config.js.
ANCHOR_WALLET=~/.config/solana/carbonledger-devnet.json   # Deploy wallet for devnet only.

# ---------- Outside data (no keys needed) ----------
# Open Food Facts asks for a descriptive User-Agent. No key. Licence is ODbL: see COMPLIANCE C12 and C13.
OPEN_FOOD_FACTS_USER_AGENT=CarbonLedger/0.2 (contact: <your email, not committed>)
OPEN_FOOD_FACTS_ENABLED=1                     # 0 turns off the server-side live lookup; unknown barcodes then need a category.
# Agribalyse values arrive inside Open Food Facts responses. Etalab open licence, attribution required.

# ---------- Growth: accounts, counts, dashboard (2026-10-14) ----------
# Sign-in by email link. Off unless both are set: then sign-in says it is not set up and stores nothing.
RESEND_API_KEY=<from resend.com, after verifying the sending domain>
EMAIL_FROM=CarbonLedger <signin@carbonledger.world>   # an address on a domain verified in Resend
PUBLIC_URL=https://carbonledger.world                 # the sign-in link points here; Seeker sign-in checks this domain
# Sign in with Seeker: a read-only mainnet lookup for the Seeker Genesis Token. Nothing is ever sent to mainnet.
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com   # a Helius or QuickNode mainnet URL is steadier
# Operator dashboard (/metrics.html). Make it on your machine: openssl rand -hex 24. Unset = the dashboard answers 404.
METRICS_TOKEN=<openssl rand -hex 24>

# ---------- Optional, later phases ----------
# A model may suggest a category and never a number (CLAUDE.md). Off unless a key is present. Not phase 1.
ANTHROPIC_API_KEY=<from console.anthropic.com, only if category suggestion is enabled>
CLAUDE_MODEL=claude-sonnet-5-5
# Error reporting. Off unless set. Events carry ids and hashes only.
SENTRY_DSN=
# Alert when the chain failure rate passes this fraction over a minute (T21).
RPC_FAILURE_ALERT_RATE=0.2
ALERT_WEBHOOK_URL=

# ---------- CI (GitHub Actions secrets, set in the repo settings, not here) ----------
# SOLANA_SECRET_KEY_B58   optional, a separate throwaway devnet key for the smoke test
# POSTGRES_PASSWORD       any value, the CI database is disposable
# API_KEY_PEPPER          any value, CI keys are disposable
